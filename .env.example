# Copy this file to .env (for local `vercel dev`) and fill in real values.
# In production, set these as Environment Variables in your Vercel project
# settings instead of committing a .env file.
#
# Both of these come from Supabase → Project Settings → API.
# SUPABASE_ANON_KEY is the public "anon" key — it is SAFE to expose in the
# browser and is injected into public/js/env-config.js at build time.
# NEVER put the service_role key in this project, in an env var read by the
# browser, or anywhere in client-side code.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
