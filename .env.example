# Copy this file to .env (for local `vercel dev`) and fill in real values.
# In production, set these as Environment Variables in your Vercel project
# settings instead of committing a .env file.
#
# Both of these come from Supabase → Project Settings → API.
# VITE_SUPABASE_ANON_KEY is the public "anon" key — it is SAFE to expose in
# the browser and is injected into public/js/env-config.js at build time,
# and read directly by the /api serverless functions at request time.
#
# Note: this project has no Vite build step — the VITE_ prefix is kept only
# because that's the exact variable name requested/expected. It's read via
# plain `process.env` both at build time and inside /api functions.
#
# NEVER put the service_role key in this project, in an env var read by the
# browser, or anywhere in client-side code.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
